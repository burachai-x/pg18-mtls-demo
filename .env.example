# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริงก่อนรัน:
#   cp .env.example .env
#
# สร้างค่าสุ่มได้ด้วย:
#   openssl rand -base64 32      # สำหรับ password / key ทั่วไป
#   openssl rand -hex 32         # สำหรับ GARAGE_RPC_SECRET (ต้องเป็น hex 32 ไบต์)

# Ports published on the host (change these if 80/443 are already taken)
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8443

# PostgreSQL settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=appdb

# Login roles — one per service, named after their client certificate CN.
# PostgreSQL requires BOTH the certificate and these passwords (pg_hba:
# scram-sha-256 + clientcert=verify-full).
WEB_DB_PASSWORD=
API_DB_PASSWORD=

# Database connection (used by PHP — required to connect before reading settings)
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb

# App-level secrets (NOT stored in DB — read from env vars at runtime)
PGCRYPTO_KEY=
REVEAL_PASSWORD=
SETTINGS_ADMIN_PASSWORD=
S3_SSE_C_KEY=

# Garage secrets (ไม่ hardcode ใน garage.toml)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
